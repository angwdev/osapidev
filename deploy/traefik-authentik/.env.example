# osapidev + Traefik + Authentik. Copy to `.env` and fill in every value.
# Generate secrets with:  openssl rand -hex 32   (DATA_ENCRYPTION_KEY: openssl rand -hex 16)

#------------------------------ Domains -----------------------------------#
# Both names must point (DNS A/AAAA records) at this server; ports 80 and 443 must be open.
OSAPIDEV_HOST=osapidev.example.com
AUTHENTIK_HOST=auth.example.com
# Let's Encrypt account email (certificate expiry notices)
ACME_EMAIL=admin@example.com

#------------------------------ osapidev ----------------------------------#
# Image tag from ghcr.io/angwdev/osapidev (e.g. 1.2.3); "latest" follows main
OSAPIDEV_VERSION=latest
OSAPIDEV_DB_PASSWORD=
# Exactly 32 characters. Encrypts secrets stored in the database; never change it afterwards.
DATA_ENCRYPTION_KEY=
# Login methods. OIDC = Authentik. Add EMAIL only if SMTP is configured in the admin dashboard.
OSAPIDEV_AUTH_PROVIDERS=OIDC
# Optional links shown on the login screen
VITE_APP_TOS_LINK=
VITE_APP_PRIVACY_POLICY_LINK=

#------------------------------ Single sign-on -----------------------------#
# Shared between Authentik (which creates the application) and osapidev. Pick any values.
OIDC_CLIENT_ID=osapidev
OIDC_CLIENT_SECRET=

#------------------------------ Authentik ---------------------------------#
AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
# Authentik admin ("akadmin"), created on first start. Sign in at https://AUTHENTIK_HOST
AUTHENTIK_ADMIN_EMAIL=admin@example.com
AUTHENTIK_ADMIN_PASSWORD=

#------------------------------ Traefik -----------------------------------#
TRAEFIK_TAG=v3.7.13
